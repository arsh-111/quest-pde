# environments
.venv/
__pycache__/
*.pyc
.pytest_cache/

# raw data, caches, third-party reference code (never committed)
data/
external/
*.h5
*.hdf5
*.npz
*.npy

# large / intermediate run artifacts
runs/
checkpoints_tmp/
*.log

# secrets
.env
*.key

# serving asset and result arrays ARE committed (found missing by the fresh-clone test)
!app/assets/*.npz
!results/*.npz
